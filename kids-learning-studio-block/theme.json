{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "800px", "wideSize": "1280px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "navy", "name": "Studio Navy", "color": "#0F2A5F" },
        { "slug": "blue", "name": "Learning Blue", "color": "#1B75E8" },
        { "slug": "blue-hover", "name": "Blue Hover", "color": "#155EC0" },
        { "slug": "cream", "name": "Warm Background", "color": "#FCFBF8" },
        { "slug": "white", "name": "White Surface", "color": "#FFFFFF" },
        { "slug": "slate", "name": "Body Text", "color": "#334155" },
        { "slug": "muted", "name": "Muted Text", "color": "#64748B" },
        { "slug": "gold", "name": "Donation Gold", "color": "#F5B700" },
        { "slug": "border", "name": "Warm Border", "color": "#E5E2D9" },
        { "slug": "orange", "name": "Category Orange", "color": "#F97316" },
        { "slug": "green", "name": "Category Green", "color": "#16A34A" },
        { "slug": "purple", "name": "Category Purple", "color": "#7C3AED" },
        { "slug": "sky", "name": "Category Sky", "color": "#0EA5E9" },
        { "slug": "pink", "name": "Category Pink", "color": "#EC4899" }
      ],
      "gradients": [
        { "slug": "sky-wash", "name": "Sky Wash", "gradient": "linear-gradient(135deg, #EFF6FF 0%, #FCFBF8 100%)" },
        { "slug": "warm-wash", "name": "Warm Wash", "gradient": "linear-gradient(135deg, #FFF7ED 0%, #FCFBF8 100%)" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "Outfit, sans-serif", "slug": "outfit", "name": "Outfit" },
        { "fontFamily": "'Plus Jakarta Sans', sans-serif", "slug": "plus-jakarta-sans", "name": "Plus Jakarta Sans" },
        { "fontFamily": "'JetBrains Mono', monospace", "slug": "jetbrains-mono", "name": "JetBrains Mono" },
        { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "slug": "system", "name": "System UI" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        { "slug": "x-large", "name": "Extra Large", "size": "1.875rem" },
        { "slug": "xx-large", "name": "Display", "size": "clamp(2.25rem, 4vw, 3.5rem)" }
      ],
      "lineHeight": true,
      "letterSpacing": true,
      "textTransforms": true
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.625rem" },
        { "slug": "20", "name": "S", "size": "1rem" },
        { "slug": "30", "name": "M", "size": "1.5rem" },
        { "slug": "40", "name": "L", "size": "2rem" },
        { "slug": "50", "name": "XL", "size": "3rem" },
        { "slug": "60", "name": "2XL", "size": "5rem" }
      ]
    },
    "border": { "radius": true, "color": true, "style": true, "width": true },
    "shadow": { "defaultPresets": false, "presets": [
      { "slug": "soft", "name": "Soft", "shadow": "0 8px 24px rgba(15,42,95,.08)" },
      { "slug": "lifted", "name": "Lifted", "shadow": "0 16px 40px rgba(15,42,95,.14)" }
    ] }
  },
  "styles": {
    "color": { "text": "var(--wp--preset--color--slate)", "background": "var(--wp--preset--color--cream)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)", "fontSize": "1rem", "lineHeight": "1.65", "fontWeight": "400" },
    "spacing": { "blockGap": "1.5rem" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--navy)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--outfit)", "fontWeight": "700", "lineHeight": "1.2" } },
      "h1": { "typography": { "fontSize": "clamp(2.25rem, 4vw, 3.5rem)", "fontWeight": "800", "lineHeight": "1.08" } },
      "h2": { "typography": { "fontSize": "clamp(1.5rem, 3vw, 1.875rem)", "fontWeight": "700", "lineHeight": "1.2" } },
      "h3": { "typography": { "fontSize": "1.125rem", "fontWeight": "700", "lineHeight": "1.35" } },
      "h4": { "typography": { "fontSize": "1rem", "fontWeight": "700", "lineHeight": "1.4" } },
      "h5": { "typography": { "fontSize": "0.9375rem", "fontWeight": "700", "lineHeight": "1.45" } },
      "h6": { "typography": { "fontSize": "0.8125rem", "fontWeight": "700", "lineHeight": "1.5", "letterSpacing": "0.04em", "textTransform": "uppercase" } },
      "link": { "color": { "text": "var(--wp--preset--color--blue)" }, "typography": { "textDecoration": "none" }, ":hover": { "color": { "text": "var(--wp--preset--color--blue-hover)" }, "typography": { "textDecoration": "underline" } } },
      "button": { "border": { "radius": "12px" }, "color": { "background": "var(--wp--preset--color--blue)", "text": "var(--wp--preset--color--white)" }, "spacing": { "padding": { "top": "0.875rem", "bottom": "0.875rem", "left": "1.5rem", "right": "1.5rem" } }, "typography": { "fontFamily": "var(--wp--preset--font-family--plus-jakarta-sans)", "fontSize": "0.875rem", "fontWeight": "700" }, ":hover": { "color": { "background": "var(--wp--preset--color--blue-hover)", "text": "var(--wp--preset--color--white)" } }, ":focus": { "outline": { "color": "var(--wp--preset--color--blue)", "style": "solid", "width": "2px", "offset": "3px" } } }
    },
    "blocks": {
      "core/group": { "spacing": { "blockGap": "1.25rem" } },
      "core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--outfit)" } },
      "core/post-featured-image": { "border": { "radius": "16px" } },
      "core/image": { "border": { "radius": "16px" } },
      "core/navigation": { "typography": { "fontSize": "0.875rem", "fontWeight": "600" } },
      "core/search": { "border": { "radius": "12px" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-contact", "title": "Contact Page", "postTypes": ["page"] },
    { "name": "page-about", "title": "About Page", "postTypes": ["page"] }
  ]
}
